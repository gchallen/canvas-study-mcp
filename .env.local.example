# Machine-specific settings for the local Canvas and VM tests. Copy to .env.local (gitignored).

# The local development Canvas: its address, the directory holding its compose scripts, and the
# password of its "student" user.
CANVAS_URL=https://canvas.example.localhost
CANVAS_DIR=/path/to/local/canvas
CANVAS_STUDENT_PASSWORD=

# The clean macOS VM image that scripts/vm/vm.sh create clones, and the account inside it.
# The image's SSH key is expected beside it, as vm_key and vm_key.pub.
CANVAS_STUDY_VM_SOURCE=/path/to/clean.macvm
CANVAS_STUDY_VM_USER=
CANVAS_STUDY_VM_PASSWORD=
