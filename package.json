{
  "name": "canvas-study-mcp",
  "version": "2026.11.0",
  "description": "A local, read-only Canvas MCP server for students, built around evidence-based study practices",
  "type": "module",
  "license": "MIT",
  "author": "Geoffrey Challen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gchallen/canvas-study-mcp.git"
  },
  "homepage": "https://github.com/gchallen/canvas-study-mcp#readme",
  "bugs": "https://github.com/gchallen/canvas-study-mcp/issues",
  "keywords": [
    "mcp",
    "canvas",
    "lms",
    "students",
    "spaced-repetition",
    "study"
  ],
  "bin": {
    "canvas-study-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --banner:js='#!/usr/bin/env node'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "pack:mcpb": "npm run build && node scripts/pack-mcpb.mjs",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "ts-fsrs": "^6.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
